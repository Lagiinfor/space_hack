# Python's private copy of its add-ons: each computer makes its own (start.bat does it)
.venv/
__pycache__/
*.pyc

# Single SPHEREx photos (about 45 MB per position). The app downloads them again
# automatically when needed; the small stacked results next to them are kept.
data/*/cutouts_*/
data/**/*.part
data/**/*_partial.json

# Odds and ends
.DS_Store
Thumbs.db

# Only the five tour targets' small results are shared; other spots you open stay on your computer
data/*
!data/tour.json
!data/ra133.7593_dec-7.2421/
!data/ra248.1672_dec+66.7550/
!data/ra269.4464_dec+4.7686/
!data/ra331.0970_dec-56.8008/
!data/ra76.9566_dec+30.4013/
!data/ra162.2951_dec-53.3169/
!data/ra77.9860_dec-45.0600/
!data/ra148.9685_dec+69.6797/
!data/ra260.6592_dec-23.8261/
!data/ra29.0314_dec+28.7635/
# raw NEOSSat downloads (the stacked result is kept)
data/*/neossat/
# reports saved by people using the tool on this computer
reports/
